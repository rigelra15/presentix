{
  "name": "wfh-attendance",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "npm run setup:secrets && npm run db:up && npm run build && npm run migrate && npm run seed",
    "setup:secrets": "node scripts/setup-secrets.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "build": "npm run build --workspaces",
    "migrate": "npm run migration:run -w employee-service && npm run migration:run -w attendance-service",
    "seed": "npm run seed -w employee-service",
    "dev:employee": "npm run start:dev -w employee-service",
    "dev:attendance": "npm run start:dev -w attendance-service",
    "dev:web": "npm run dev -w web",
    "test": "npm run test -w employee-service -w attendance-service",
    "lint": "npm run lint --workspaces",
    "check:login": "node scripts/check-login.mjs"
  }
}
